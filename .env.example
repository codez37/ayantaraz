# ==========================================
# Server Configuration
# ==========================================
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# ==========================================
# API URLs
# ==========================================
API_URL=http://localhost:3001/api
FRONTEND_URL=http://localhost:3000
SITE_URL=http://localhost:3000
INTERNAL_API_URL=http://localhost:3001/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ayantaraz_db?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ayantaraz_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database Pool Configuration
DB_POOL_MAX_CONNECTIONS=50
DB_POOL_MIN_CONNECTIONS=10
DB_POOL_MAX_REQUESTS_PER_CONNECTION=100
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# ==========================================
# Redis Configuration
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ==========================================
# JWT Configuration
# ==========================================
JWT_SECRET=your_jwt_secret_key_here_change_in_production_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_change_in_production_min_32_chars
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ==========================================
# Security Configuration
# ==========================================
FILE_ENCRYPTION_KEY=your_file_encryption_key_here_32_chars
SESSION_SECRET=your_session_secret_key_here_min_32_chars
ENABLE_CSRF=false

# ==========================================
# CORS Configuration
# ==========================================
ALLOW_ALL_ORIGINS=false
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# ==========================================
# Cookie Configuration
# ==========================================
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=localhost

# ==========================================
# Logging Configuration
# ==========================================
LOG_LEVEL=info
TZ=Asia/Tehran

# ==========================================
# File Upload Configuration
# ==========================================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# ==========================================
# Rate Limiting Configuration
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMITER_FAIL_OPEN=true

# ==========================================
# OTP Configuration
# ==========================================
OTP_EXPIRATION_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_LIMIT=3
OTP_RESEND_WINDOW_MINUTES=10
OTP_BLOCK_DURATION_MINUTES=30

# ==========================================
# SMS Configuration
# ==========================================
SMS_API_KEY=
SMS_PROVIDER=sms-panel
SMS_FROM=ayantaraz
ADMIN_PHONE=09123456789

# ==========================================
# Health Check Configuration
# ==========================================
HEALTH_CHECK_INTERVAL=30000

# ==========================================
# Email Configuration (Optional)
# ==========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ==========================================
# AWS S3 Configuration (Optional)
# ==========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ==========================================
# Cloudflare Configuration (Optional)
# ==========================================
CLOUDFLARE_API_KEY=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_EMAIL=
