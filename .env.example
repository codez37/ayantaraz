# ===========================================
# Ayantaraz Production Environment Configuration
# ===========================================

# Node Environment
NODE_ENV=production

# ===========================================
# API Configuration
# ===========================================
PORT=3001
API_URL=http://localhost:3001
INTERNAL_API_URL=http://api:3001/api

# ===========================================
# Web Configuration
# ===========================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ===========================================
# Database Configuration (PostgreSQL)
# ===========================================
DATABASE_URL=postgresql://ayantaraz:your_secure_password@postgres:5432/ayantaraz?schema=public&connection_limit=50&pool_timeout=10&statement_timeout=30000&idle_timeout=60
POSTGRES_USER=ayantaraz
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=ayantaraz

# ===========================================
# Redis Configuration
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_URL=redis://:your_redis_password_here@redis:6379

# ===========================================
# JWT Configuration
# ===========================================
JWT_SECRET=your_secure_jwt_secret_key_here_minimum_32_characters_long
JWT_REFRESH_SECRET=your_secure_jwt_refresh_secret_key_here_minimum_32_characters_long
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ===========================================
# File Encryption
# ===========================================
FILE_ENCRYPTION_KEY=your_32_byte_encryption_key_here_exactly_32_chars

# ===========================================
# Session Configuration
# ===========================================
SESSION_SECRET=your_secure_session_secret_here_minimum_32_characters

# ===========================================
# SMS Configuration
# ===========================================
SMS_API_KEY=your_sms_api_key_here
SMS_PROVIDER=sms-panel
SMS_FROM=ayantaraz
ADMIN_PHONE=09133374162,09134292329

# ===========================================
# Security Configuration
# ===========================================
ALLOW_ALL_ORIGINS=false
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,http://202.133.91.13,http://202.133.91.13:3000,http://202.133.91.13:3001
COOKIE_SECURE=true
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=202.133.91.13
ENABLE_CSRF=true

# ===========================================
# Logging Configuration
# ===========================================
LOG_LEVEL=info

# ===========================================
# Timezone
# ===========================================
TZ=Asia/Tehran

# ===========================================
# File Upload Configuration
# ===========================================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=/app/uploads

# ===========================================
# Rate Limiting Configuration
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMITER_FAIL_OPEN=true

# ===========================================
# OTP Configuration
# ===========================================
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_LIMIT=3
OTP_RESEND_WINDOW_MINUTES=10
OTP_BLOCK_DURATION_MINUTES=30

# ===========================================
# Database Pool Configuration
# ===========================================
DB_POOL_MAX_CONNECTIONS=50
DB_POOL_MIN_CONNECTIONS=10
DB_POOL_MAX_REQUESTS_PER_CONNECTION=100
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# ===========================================
# Health Check Configuration
# ===========================================
HEALTH_CHECK_INTERVAL=30000
