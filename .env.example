# =============================================================================
# Ayantaraz Environment Configuration Example
# Copy this file to .env and fill in the values for development
# For production, use .env.production and set all required values
# =============================================================================

# -----------------------------------------------------------------------------
# CORE APPLICATION SETTINGS
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
DOCKER_ENV=false

# -----------------------------------------------------------------------------
# SERVER URLs
# -----------------------------------------------------------------------------
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Next.js internal API URL (Docker network hostname)
INTERNAL_API_URL=http://api:3001/api

# Next.js public API URL (baked at build time for client-side)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL)
# REQUIRED: Set these values for database connection
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_database_password
POSTGRES_DB=your_database_name

# -----------------------------------------------------------------------------
# REDIS CONFIGURATION (Cache & Rate Limiting)
# REQUIRED: Set these values for Redis connection
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_URL=redis://:your_redis_password@localhost:6379

# -----------------------------------------------------------------------------
# JWT AUTHENTICATION
# REQUIRED: Generate new secrets for production
# Generate with: openssl rand -base64 48
# -----------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_key_generated_with_openssl
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_generated_with_openssl
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# -----------------------------------------------------------------------------
# SECURITY SETTINGS
# -----------------------------------------------------------------------------
FILE_ENCRYPTION_KEY=your_file_encryption_key_32_or_more_characters
CAPTCHA_SECRET=your_recaptcha_secret_key
ALLOW_ALL_ORIGINS=true
TRUSTED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:3001

# -----------------------------------------------------------------------------
# COOKIE SETTINGS
# For production with HTTPS, set COOKIE_SECURE=true
# -----------------------------------------------------------------------------
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=localhost

# -----------------------------------------------------------------------------
# DATABASE CONNECTION POOL
# -----------------------------------------------------------------------------
DB_POOL_MAX_CONNECTIONS=20
DB_POOL_MIN_CONNECTIONS=5
DB_POOL_MAX_REQUESTS_PER_CONNECTION=100
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# SESSION CONFIGURATION
# -----------------------------------------------------------------------------
SESSION_SECRET=your_session_secret_key

# -----------------------------------------------------------------------------
# RATE LIMITING CONFIGURATION
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMITER_FAIL_OPEN=true

# -----------------------------------------------------------------------------
# SMS CONFIGURATION (REQUIRED for OTP)
# Provider: SAPI.IR
# Generate at: https://sapi.ir
# REQUIRED: Set SMS_API_KEY for OTP functionality to work
# -----------------------------------------------------------------------------
SMS_API_KEY=your_sms_api_key_from_sapi_ir
SMS_PROVIDER=sms-panel
SMS_FROM=Ayantaraz

# -----------------------------------------------------------------------------
# ADMIN PHONE NUMBERS (Comma-separated, will be seeded in database)
# -----------------------------------------------------------------------------
ADMIN_PHONE=09133374162,09134292329

# -----------------------------------------------------------------------------
# LOGGING CONFIGURATION
# -----------------------------------------------------------------------------
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# FILE UPLOAD CONFIGURATION
# -----------------------------------------------------------------------------
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,text/plain,application/json

# -----------------------------------------------------------------------------
# HEALTH CHECK CONFIGURATION
# -----------------------------------------------------------------------------
HEALTH_CHECK_INTERVAL=30000

# -----------------------------------------------------------------------------
# OTP CONFIGURATION
# -----------------------------------------------------------------------------
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_LIMIT=3
OTP_RESEND_WINDOW_MINUTES=10
OTP_BLOCK_DURATION_MINUTES=30

# -----------------------------------------------------------------------------
# TIMEZONE
# -----------------------------------------------------------------------------
TZ=Asia/Tehran

# -----------------------------------------------------------------------------
# DOCKER SPECIFIC
# -----------------------------------------------------------------------------
HOSTNAME=0.0.0.0

# =============================================================================
# IMPORTANT NOTES:
# =============================================================================
# 1. For PRODUCTION deployment:
#    - Copy this file to .env.production
#    - Set ALL required values in .env.production
#    - NEVER commit actual secrets to version control
# 
# 2. Required values for production:
#    - POSTGRES_PASSWORD: Database password
#    - REDIS_PASSWORD: Redis password
#    - JWT_SECRET: JWT signing secret (generate with: openssl rand -base64 48)
#    - JWT_REFRESH_SECRET: JWT refresh token secret (generate with: openssl rand -base64 48)
#    - FILE_ENCRYPTION_KEY: File encryption key (32+ characters)
#    - SESSION_SECRET: Session secret key
#    - SMS_API_KEY: SMS provider API key (from sapi.ir or other provider)
# 
# 3. For development, you can use test values
# 
# 4. For HTTPS in production:
#    - Set COOKIE_SECURE=true
#    - Update all URLs to use https://
#    - Set up SSL certificates
# =============================================================================
