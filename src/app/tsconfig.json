{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/app",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@app/*": ["./*"],
      "@common/*": ["./common/*"],
      "@modules/*": ["./modules/*"],
      "@config/*": ["./config/*"],
      "@core/*": ["./core/*"],
      "@infrastructure/*": ["./infrastructure/*"],
      "@prisma/*": ["./prisma/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["**/*.spec.ts", "**/*.test.ts", "node_modules", "dist"]
}
