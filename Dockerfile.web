# Production Dockerfile for Ayantaraz Web (Next.js)
# Multi-stage build for optimal production image

# ==========================================
# Stage 1: Builder
# ==========================================
FROM node:20-alpine AS builder

WORKDIR /app

# Enable corepack and install specific pnpm version
RUN corepack enable && corepack prepare pnpm@8.15.1 --activate

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY src/web/package.json ./src/web/package.json

# Install all dependencies (including devDependencies for build)
RUN pnpm install --frozen-lockfile

# Copy source files
COPY src/web/ ./src/web/
COPY .env.example ./

# Build the Next.js application
RUN pnpm run build:web

# ==========================================
# Stage 2: Production
# ==========================================
FROM node:20-alpine AS production

WORKDIR /app

# Install curl for healthcheck
RUN apk add --no-cache curl

# Enable corepack and install specific pnpm version
RUN corepack enable && corepack prepare pnpm@8.15.1 --activate

# Copy package files
COPY package.json pnpm-lock.yaml ./

# Install production dependencies only
RUN pnpm install --frozen-lockfile --production

# Copy standalone Next.js server and static assets
COPY --from=builder /app/src/web/.next/standalone ./
COPY --from=builder /app/src/web/.next/static ./.next/static
COPY --from=builder /app/src/web/public ./public
COPY --from=builder /app/src/web/package.json ./package.json
COPY --from=builder /app/src/web/next.config.js ./next.config.js

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

# Create necessary directories
RUN mkdir -p .next/cache .next/standalone && \
    chown -R nodejs:nodejs /app

# Switch to non-root user
USER nodejs

# Set environment variables
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Health check configuration
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=5 \
  CMD curl -f http://localhost:3000 || exit 1

# Start the Next.js standalone server
CMD ["node", "server.js"]
