# Production Dockerfile for Ayantaraz Web (Next.js)
# Stage 1: Builder
FROM node:22-alpine AS builder

WORKDIR /app

# Enable corepack and install pnpm
RUN corepack enable && corepack prepare pnpm@11.9.0 --activate

# Copy package files
COPY package.json ./

# Install all dependencies (including devDependencies for build)
RUN pnpm install --frozen-lockfile --production=false

# Copy source files
COPY src/web/ ./src/web/
COPY .env.example ./

# Build the application
RUN pnpm run build:web

# Stage 2: Production
FROM node:22-alpine AS production

WORKDIR /app

# Enable corepack and install pnpm
RUN corepack enable && corepack prepare pnpm@11.9.0 --activate

# Copy package files
COPY package.json ./

# Install production dependencies only
RUN pnpm install --frozen-lockfile --production

# Copy built files from builder
COPY --from=builder /app/src/web/.next ./.next
COPY --from=builder /app/src/web/public ./public
COPY --from=builder /app/src/web/package.json ./package.json
COPY --from=builder /app/src/web/next.config.js ./next.config.js
COPY --from=builder /app/src/web/tailwind.config.ts ./tailwind.config.ts

# Environment variables
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV NEXT_PUBLIC_SITE_URL=http://202.133.91.13
ENV NEXT_PUBLIC_API_URL=http://202.133.91.13:3001
ENV INTERNAL_API_URL=http://api:3001/api

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000 || exit 1

# Start the application
CMD ["node", "server.js"]
