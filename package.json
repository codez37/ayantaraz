{
  "name": "ayantaraz",
  "version": "2.1.0",
  "private": true,
  "description": "آیانتاراز - سیستم حسابداری و مشاوره مالی هوشمند",
  "author": "Ayantaraz Team",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "concurrently \"pnpm run dev:api\" \"pnpm run dev:web\"",
    "dev:api": "cd src/app && nest start --watch",
    "dev:web": "cd src/web && next dev -p 3000",
    "build": "pnpm run build:api && pnpm run build:web",
    "build:api": "cd src/app && nest build",
    "build:web": "cd src/web && next build",
    "start": "cd src/app && nest start",
    "start:api": "cd src/app && nest start --watch",
    "start:web": "cd src/web && next start -p 3000",
    "start:prod": "NODE_ENV=production node src/app/dist/main",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "lint:api": "cd src/app && eslint \"**/*.ts\" --fix",
    "lint:web": "cd src/web && next lint",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,json,css,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,json,css,scss}\"",
    "typecheck": "cd src/app && tsc --noEmit",
    "typecheck:web": "cd src/web && tsc --noEmit",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio --schema=prisma/schema.prisma",
    "db:validate": "prisma validate --schema=prisma/schema.prisma",
    "db:migrate:prod": "prisma migrate deploy --schema=prisma/schema.prisma",
    "docker:up": "docker compose --profile production up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build --no-cache",
    "docker:prod": "docker compose -f docker-compose.yml up -d --build",
    "docker:logs": "docker compose logs -f",
    "docker:restart": "docker compose restart",
    "healthcheck": "curl -s http://localhost:3001/api/health | jq",
    "test:api": "cd src/app && jest",
    "test:e2e": "cd src/app && jest --config ./test/jest-e2e.json",
    "test:coverage": "cd src/app && jest --coverage",
    "clean": "rm -rf dist .next node_modules/.prisma",
    "setup": "pnpm install && pnpm db:generate && pnpm db:migrate && pnpm db:seed",
    "prisma:generate": "pnpm exec prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "pnpm exec prisma migrate dev --schema=prisma/schema.prisma"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/sanitize-html": "^2.11.0",
    "@types/node": "^20.11.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^2.0.16",
    "@types/validator": "^13.11.9",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "globals": "^17.0.0",
    "prettier": "^3.2.5",
    "prisma": "^5.22.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@keyv/redis": "^5.1.6",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "cache-manager": "^6.4.3",
    "keyv": "^5.3.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "rate-limiter-flexible": "^5.0.5",
    "sanitize-html": "^2.14.0",
    "xss": "^1.0.15",
    "crypto-js": "^4.2.0",
    "eventemitter2": "^6.4.9",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "next": "^14.2.35",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "redis": "^4.6.13",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "validator": "^13.11.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "packageManager": "pnpm@8.15.1",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
